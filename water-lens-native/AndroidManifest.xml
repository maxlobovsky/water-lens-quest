<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.max.waterlens" android:versionCode="10" android:versionName="0.10-full-view-lab">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="32"/>
  <uses-feature android:glEsVersion="0x00030000" android:required="true"/>
  <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="true"/>
  <uses-feature android:name="com.oculus.feature.PASSTHROUGH" android:required="true"/>
  <uses-feature android:name="horizonos.feature.HEADSET_CAMERA" android:required="true"/>
  <uses-feature android:name="oculus.software.handtracking" android:required="false"/>
  <uses-permission android:name="com.oculus.permission.HAND_TRACKING"/>
  <uses-permission android:name="horizonos.permission.HEADSET_CAMERA"/>
  <uses-permission android:name="android.permission.CAMERA"/>
  <uses-permission android:name="com.oculus.permission.USE_SCENE"/>
  <uses-permission android:name="org.khronos.openxr.permission.OPENXR"/>
  <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM"/>
  <queries>
    <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker"/>
    <intent><action android:name="org.khronos.openxr.OpenXRRuntimeService"/></intent>
  </queries>
  <application android:label="Water Lens Stereo" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:allowBackup="false"
      android:hasCode="true" android:extractNativeLibs="true">
    <meta-data android:name="com.oculus.supportedDevices" android:value="quest3|quest3s"/>
    <meta-data android:name="com.oculus.handtracking.version" android:value="V2.0"/>
    <activity android:name=".WaterLensActivity" android:exported="true"
        android:launchMode="singleTask" android:screenOrientation="landscape"
        android:configChanges="screenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation|uiMode|density"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
      <meta-data android:name="android.app.lib_name" android:value="waterlens"/>
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
        <category android:name="com.oculus.intent.category.VR"/>
        <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
